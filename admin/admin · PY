#!/usr/bin/env python3
"""Ajusta o admin/index.html para bater com a loja corrigida.
Uso: python3 aplicar_admin.py admin/index.html   (faz backup em .bak e lista o que não encontrou)"""
import sys, pathlib, shutil
f = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else 'admin/index.html')
h = f.read_text(encoding='utf-8'); shutil.copy(f, str(f) + '.bak'); miss = []
def rep(o, n):
    global h
    if h.count(o) != 1: miss.append(o[:70]); return
    h = h.replace(o, n)
# campo do desconto Pix (a loja usa, o painel não tinha onde editar)
rep("${inp('Parcelas sem juros exibidas na loja','site.parcelas',{t:'number',a:'min=1 max=12'})}",
    "${inp('Parcelas sem juros exibidas na loja','site.parcelas',{t:'number',a:'min=1 max=12'})}${inp('Desconto no Pix (%)','site.pix',{t:'number',a:'min=0 max=100 step=0.1'})}")
# nome, frase e dados legais do rodapé
rep("${inp('Rodapé','site.textos.rodape',{t:'ta',full:1})}",
    "${inp('Rodapé','site.textos.rodape',{t:'ta',full:1})}${inp('Nome da loja','site.nome')}${inp('Frase da marca','site.frase')}${inp('Razão social','site.razaoSocial')}${inp('CNPJ','site.cnpj',{ph:'00.000.000/0000-00'})}${inp('Endereço completo','site.endereco',{full:1})}${inp('Link da página de trocas e devoluções','site.linkTrocas',{ph:'https://…'})}${inp('Link da política de privacidade','site.linkPrivacidade',{ph:'https://…'})}")
# esses campos precisam sair no dados.json que a loja lê
rep("nome:S.nome||'MAUY',whatsapp:S.whatsapp||'',frase:S.frase||'',rodape:S.textos?.rodape||'',",
    "nome:S.nome||'MAUY',whatsapp:S.whatsapp||'',frase:S.frase||'',razaoSocial:S.razaoSocial||'',cnpj:S.cnpj||'',endereco:S.endereco||'',linkTrocas:S.linkTrocas||'',linkPrivacidade:S.linkPrivacidade||'',rodape:S.textos?.rodape||'',")
# o painel gravava um "rascunho" após publicar, que a loja passa a mostrar no lugar do catálogo publicado
rep("try{localStorage.setItem('mauy_draft',JSON.stringify(storefrontOut(S,Pd)))}catch(e){};",
    "try{localStorage.removeItem('mauy_draft')}catch(e){};")
f.write_text(h, encoding='utf-8'); print('OK')
[print(' - não achei:', m) for m in miss]
